{
    "name": "restruct/wkhtmltopdf-static",
    "description": "Pre-compiled wkhtmltopdf 0.12.6 (patched Qt) for Linux and macOS, with a fluent PHP wrapper that replaces knp-snappy and a multi-arch Docker fallback",
    "keywords": ["php", "pdf", "wkhtmltopdf", "html-to-pdf", "knp-snappy", "docker", "static-binaries"],
    "license": "(MIT AND LGPL-3.0-or-later)",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/process": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "restruct/xpdf-static": "^1.0.2"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\WkhtmltoPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\WkhtmltoPdf\\Tests\\": "tests/"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ],
    "scripts": {
        "test": "phpunit"
    }
}
