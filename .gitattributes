# Keep build-only files out of dist installs (Packagist zips). The Docker image
# is built from build/ by the maintainer; consumers pull it from ghcr.io instead.
/build          export-ignore
/.gitattributes export-ignore
# Test suite and dev config stay out of dist installs too
/tests             export-ignore
/phpunit.xml.dist  export-ignore
/.gitignore        export-ignore
